<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_sale_order_goods_in" model="ir.sequence">
        <field name="name">Goods In Order</field>
        <field name="code">sale.order.goods.in</field>
        <field name="prefix">GI</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_sale_order_goods_out" model="ir.sequence">
        <field name="name">Goods Out Order</field>
        <field name="code">sale.order.goods.out</field>
        <field name="prefix">GO</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_sale_order_transport" model="ir.sequence">
        <field name="name">Transport Order</field>
        <field name="code">sale.order.transport</field>
        <field name="prefix">TR</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
