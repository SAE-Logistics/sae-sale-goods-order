        <field name="name">Order Receipt (Goods Out)</field>
        <field name="type">service</field>
        <field name="service_type">manual</field>
        <field name="list_price">1.00</field>
    </record>
    <record id="prod_go_sku_picked" model="product.product">
        <field name="name">SKU Picked (Goods Out)</field>
        <field name="type">service</field>
        <field name="service_type">manual</field>
        <field name="list_price">1.50</field>
    </record>
    <record id="prod_go_qty_picked" model="product.product">
        <field name="name">Qty Picked (Goods Out)</field>
        <field name="type">service</field>
        <field name="service_type">manual</field>
        <field name="list_price">1.50</field>
    </record>
</odoo>
