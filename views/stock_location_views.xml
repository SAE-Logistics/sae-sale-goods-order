<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_inherit_storage_product" model="ir.ui.view">
        <field name="name">stock.location.form.inherit.storage.product</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='additional_info']/field[@name='storage_category_id']" position="after">
                <field name="storage_product_id" invisible="usage != 'internal'"/>
                <field name="max_pallet_capacity" invisible="usage != 'internal'"/>
            </xpath>
        </field>
    </record>
</odoo>
