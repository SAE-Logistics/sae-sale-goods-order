<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_tree_inherit_container" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.container</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_packaging_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="container_type_id"/>
                <field name="container_count" sum="Total Containers"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_receipt_picking_inherit_container" model="ir.ui.view">
        <field name="name">stock.move.tree.receipt.picking.inherit.container</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree_receipt_picking"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="container_type_id"/>
                <field name="container_count" sum="Total Containers"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_container" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.container</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="container_type_id" readonly="state in ('done', 'cancel')"/>
                <field name="container_count" readonly="state in ('done', 'cancel')" sum="Total Containers"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_operations_inherit_container" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.container</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="container_type_id" readonly="state in ('done', 'cancel')"/>
                <field name="container_count" readonly="state in ('done', 'cancel')" sum="Total Containers"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_inherit_container" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.inherit.container</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="container_type_id" readonly="(state == 'done' and is_locked) or (package_level_id and parent.picking_type_entire_packs)"/>
                <field name="container_count" readonly="(state == 'done' and is_locked) or (package_level_id and parent.picking_type_entire_packs)" sum="Total Containers"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit_container" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operation.tree.inherit.container</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="container_type_id" readonly="state in ('done', 'cancel') and is_locked"/>
                <field name="container_count" readonly="state in ('done', 'cancel') and is_locked" sum="Total Containers"/>
            </xpath>
        </field>
    </record>
</odoo>
