<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_form_view_inherit_surcharge" model="ir.ui.view">
        <field name="name">product.product.form.inherit.surcharge</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_surcharge_product"/>
                    <label for="is_surcharge_product"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
