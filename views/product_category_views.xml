<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_view_inherit_customer_access" model="ir.ui.view">
        <field name="name">product.category.form.inherit.customer.access</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="inside">
                <field name="customer_id"/>
                <field name="goods_owner_customer_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
