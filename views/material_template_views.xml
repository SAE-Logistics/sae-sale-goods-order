<!-- stock_materials_consumption/views/material_template_views.xml -->
<odoo>
    <record id="view_sale_material_template_form" model="ir.ui.view">
        <field name="name">sale.material.template.form</field>
        <field name="model">sale.material.template</field>
        <field name="arch" type="xml">
            <form string="Materials Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="picking_type_id"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="default_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_material_template_tree" model="ir.ui.view">
        <field name="name">sale.material.template.tree</field>
        <field name="model">sale.material.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_sale_material_template" model="ir.actions.act_window">
        <field name="name">Materials Templates</field>
        <field name="res_model">sale.material.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_material_template_root"
              name="Materials Templates"
              parent="sale.menu_sale_config"
              action="action_sale_material_template"/>
</odoo>
