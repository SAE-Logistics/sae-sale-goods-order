<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_goods_invoice" model="report.paperformat">
        <field name="name">Warehouse Invoice</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">2</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_goods_invoice" model="ir.actions.report">
        <field name="name">Warehouse Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_goods_order.report_goods_invoice_document</field>
        <field name="report_file">sale_goods_order.report_goods_invoice_document</field>
        <field name="paperformat_id" ref="sale_goods_order.paperformat_goods_invoice"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Warehouse Invoice - %s' % (object.name or object.ref or '')</field>
    </record>
</odoo>
