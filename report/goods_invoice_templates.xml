<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_goods_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
                <t t-set="data" t-value="o._get_warehouse_invoice_report_data()"/>
                <t t-set="rows" t-value="data.get('rows')"/>

                <t t-call="web.basic_layout">
                    <div class="page warehouse-invoice-page">
                        <style>
                            .warehouse-invoice-page {
                                font-family: Arial, sans-serif;
                                color: #181818;
                                font-size: 10px;
                                padding: 0 8px;
                            }
                            .warehouse-header,
                            .warehouse-meta,
                            .warehouse-lines,
                            .warehouse-bottom {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .warehouse-header td,
                            .warehouse-meta td,
                            .warehouse-bottom td {
                                padding: 0;
                                vertical-align: top;
                            }
                            .warehouse-logo {
                                max-height: 78px;
                                max-width: 255px;
                            }
                            .company-address {
                                color: #596d98;
                                font-size: 10.5px;
                                line-height: 1.35;
                                text-align: right;
                            }
                            .company-address .website {
                                color: #719f43;
                                font-size: 13px;
                                font-weight: bold;
                            }
                            .warehouse-title {
                                margin-top: 16px;
                                margin-bottom: 14px;
                                font-size: 24px;
                                font-weight: bold;
                                color: #111;
                            }
                            .warehouse-meta {
                                margin-bottom: 52px;
                                font-size: 10.5px;
                            }
                            .customer-address {
                                padding-left: 24px;
                                line-height: 1.4;
                            }
                            .invoice-details {
                                width: 290px;
                                margin-left: auto;
                                border-collapse: collapse;
                            }
                            .invoice-details td {
                                padding: 0 0 11px;
                                vertical-align: top;
                            }
                            .invoice-details .label {
                                width: 49%;
                                padding-right: 12px;
                                font-weight: bold;
                            }
                            .invoice-details .value {
                                width: 51%;
                            }
                            .warehouse-lines {
                                table-layout: fixed;
                                font-size: 9.5px;
                            }
                            .warehouse-lines thead {
                                display: table-header-group;
                            }
                            .warehouse-lines th {
                                padding: 5px 2px;
                                border-bottom: 2px solid #333;
                                text-align: left;
                                font-size: 10px;
                                font-weight: bold;
                            }
                            .warehouse-lines td {
                                padding: 5px 2px;
                                border-bottom: 1px solid #b7b7b7;
                                vertical-align: top;
                            }
                            .warehouse-lines .description { width: 42%; }
                            .warehouse-lines .quantity { width: 13%; text-align: right; }
                            .warehouse-lines .unit-price { width: 16%; text-align: right; }
                            .warehouse-lines .vat { width: 10%; text-align: center; }
                            .warehouse-lines .amount { width: 19%; text-align: right; }
                            .nowrap { white-space: nowrap; }
                            .warehouse-bottom {
                                margin-top: 8px;
                                page-break-inside: avoid;
                            }
                            .due-date {
                                padding-top: 98px !important;
                                font-size: 11px;
                                font-weight: bold;
                            }
                            .warehouse-totals {
                                width: 390px;
                                margin-left: auto;
                                border-collapse: collapse;
                                font-size: 10.5px;
                            }
                            .warehouse-totals td {
                                padding: 5px 3px;
                            }
                            .warehouse-totals .label {
                                text-align: right;
                                font-weight: bold;
                            }
                            .warehouse-totals .amount {
                                width: 34%;
                                text-align: right;
                                white-space: nowrap;
                            }
                            .warehouse-totals .rule td {
                                border-top: 2px solid #333;
                            }
                            .warehouse-totals .grand-total td {
                                border-top: 2px solid #333;
                                border-bottom: 2px solid #333;
                                font-size: 11px;
                                font-weight: bold;
                            }
                            .warehouse-totals .amount-due td {
                                padding-top: 9px;
                                font-size: 11px;
                                font-weight: bold;
                            }
                            .warehouse-footer {
                                margin-top: 45px;
                                border-top: 1px solid #d8dbe3;
                                padding-top: 7px;
                                color: #556a99;
                                font-size: 8.5px;
                                line-height: 1.35;
                            }
                        </style>

                        <table class="warehouse-header">
                            <tr>
                                <td style="width: 48%;">
                                    <img t-if="company.logo"
                                         t-att-src="image_data_uri(company.logo)"
                                         class="warehouse-logo"
                                         alt="Company Logo"/>
                                </td>
                                <td style="width: 52%;" class="company-address">
                                    <div><span t-esc="company.street or ''"/></div>
                                    <div t-if="company.street2"><span t-esc="company.street2"/></div>
                                    <div>
                                        <span t-esc="company.city or ''"/>
                                        <t t-if="company.city and company.state_id">, </t>
                                        <span t-esc="company.state_id.name if company.state_id else ''"/>
                                        <t t-if="company.zip">, </t><span t-esc="company.zip or ''"/>
                                    </div>
                                    <div t-if="company.phone"><strong>T:</strong> <span t-esc="company.phone"/></div>
                                    <div t-if="company.email"><strong>E:</strong> <span t-esc="company.email"/></div>
                                    <div class="website" t-if="company.website">
                                        <span t-esc="company.website.replace('http://', '').replace('https://', '')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <div class="warehouse-title">TAX INVOICE</div>

                        <table class="warehouse-meta">
                            <tr>
                                <td style="width: 48%;">
                                    <div class="customer-address">
                                        <div t-if="o.partner_id.name"><strong t-esc="o.partner_id.name"/></div>
                                        <div t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/></div>
                                        <div t-if="o.partner_id.street2"><span t-esc="o.partner_id.street2"/></div>
                                        <div t-if="o.partner_id.city"><span t-esc="o.partner_id.city"/></div>
                                        <div t-if="o.partner_id.state_id"><span t-esc="o.partner_id.state_id.name"/></div>
                                        <div t-if="o.partner_id.zip"><span t-esc="o.partner_id.zip"/></div>
                                    </div>
                                </td>
                                <td style="width: 52%;">
                                    <table class="invoice-details">
                                        <tr>
                                            <td class="label">Invoice Date</td>
                                            <td class="value"><span t-field="o.invoice_date"/></td>
                                        </tr>
                                        <tr>
                                            <td class="label">Account Reference</td>
                                            <td class="value"><span t-esc="o.commercial_partner_id.ref or o.partner_id.ref or ''"/></td>
                                        </tr>
                                        <tr>
                                            <td class="label">Invoice Number</td>
                                            <td class="value"><span t-esc="o.name if o.name and o.name != '/' else 'Draft'"/></td>
                                        </tr>
                                        <tr>
                                            <td class="label">Reference</td>
                                            <td class="value">Warehouse</td>
                                        </tr>
                                        <tr>
                                            <td class="label">VAT Number</td>
                                            <td class="value"><span t-esc="company.vat or ''"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <table class="warehouse-lines">
                            <thead>
                                <tr>
                                    <th class="description">Description</th>
                                    <th class="quantity">Quantity</th>
                                    <th class="unit-price">Unit Price</th>
                                    <th class="vat">VAT</th>
                                    <th class="amount">Amount <span t-esc="o.currency_id.name"/></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td class="description"><span t-esc="row.get('description')"/></td>
                                    <td class="quantity nowrap"><span t-esc="'%.2f' % row.get('quantity')"/></td>
                                    <td class="unit-price nowrap">
                                        <span t-out="row.get('unit_price')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="vat"><span t-esc="row.get('tax_label')"/></td>
                                    <td class="amount nowrap">
                                        <span t-out="row.get('subtotal')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-if="not rows">
                                    <td colspan="5">No warehouse or picking-service lines are linked to this invoice.</td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="warehouse-bottom" t-if="rows">
                            <tr>
                                <td style="width: 38%;" class="due-date">
                                    <span t-if="o.invoice_date_due">Due Date: <span t-field="o.invoice_date_due"/></span>
                                </td>
                                <td style="width: 62%;">
                                    <table class="warehouse-totals">
                                        <tr>
                                            <td class="label">Subtotal</td>
                                            <td class="amount"><span t-out="data.get('untaxed')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr class="rule">
                                            <td class="label">Total VAT</td>
                                            <td class="amount"><span t-out="data.get('tax')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr class="grand-total">
                                            <td class="label">Invoice Total <span t-esc="o.currency_id.name"/></td>
                                            <td class="amount"><span t-out="data.get('total')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr class="amount-due">
                                            <td class="label">Amount Due <span t-esc="o.currency_id.name"/></td>
                                            <td class="amount"><span t-out="data.get('total')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <div class="warehouse-footer">
                            <div>
                                <strong t-esc="company.name"/>
                                <t t-if="company.company_registry"> | Company Reg no: <span t-esc="company.company_registry"/></t>
                                <t t-if="company.vat"> | VAT No: <span t-esc="company.vat"/></t>
                            </div>
                            <div t-if="company.partner_id.bank_ids">
                                <strong>Payment details:</strong>
                                <span t-esc="company.partner_id.bank_ids[0].bank_id.name or ''"/>
                                <t t-if="company.partner_id.bank_ids[0].acc_number"> | Account no: <span t-esc="company.partner_id.bank_ids[0].acc_number"/></t>
                            </div>
                            <div t-if="o.invoice_payment_term_id">
                                <strong>Payment terms:</strong> <span t-esc="o.invoice_payment_term_id.name"/>
                            </div>
                            <div t-if="company.report_footer" t-out="company.report_footer"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
