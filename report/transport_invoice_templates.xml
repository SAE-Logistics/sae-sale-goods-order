<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_transport_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
                <t t-set="data" t-value="o._get_transport_invoice_report_data()"/>
                <t t-set="rows" t-value="data.get('rows')"/>
                <t t-set="customer_order" t-value="o._get_transport_invoice_customer_order()"/>

                <t t-call="web.basic_layout">
                    <div class="page transport-invoice-page">
                        <style>
                            .transport-invoice-page {
                                font-family: Arial, sans-serif;
                                color: #4e5d83;
                                font-size: 10px;
                                padding: 0;
                            }
                            .transport-header,
                            .transport-title-block,
                            .transport-table,
                            .transport-bottom {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .transport-header td,
                            .transport-title-block td,
                            .transport-bottom td {
                                vertical-align: top;
                                padding: 0;
                            }
                            .transport-logo {
                                max-height: 70px;
                                max-width: 230px;
                            }
                            .company-address {
                                text-align: right;
                                color: #63749b;
                                font-size: 11px;
                                line-height: 1.3;
                            }
                            .company-address .website {
                                color: #79a64b;
                                font-size: 14px;
                                font-weight: bold;
                            }
                            .transport-title-block {
                                margin-top: 14px;
                                margin-bottom: 24px;
                            }
                            .customer-address {
                                color: #54658d;
                                font-size: 11px;
                                line-height: 1.16;
                            }
                            .transport-title {
                                color: #4d5f8b;
                                font-size: 22px;
                                font-weight: bold;
                                text-align: right;
                                margin-bottom: 10px;
                            }
                            .invoice-meta {
                                width: 290px;
                                margin-left: auto;
                                border-collapse: collapse;
                                font-size: 11px;
                            }
                            .invoice-meta td {
                                padding: 2px 0;
                            }
                            .invoice-meta .label {
                                width: 48%;
                                padding-right: 14px;
                                text-align: right;
                                font-weight: bold;
                            }
                            .invoice-meta .value {
                                color: #363d4d;
                            }
                            .transport-table {
                                table-layout: fixed;
                                font-size: 8.5px;
                            }
                            .transport-table th {
                                padding: 4px 3px;
                                border: 1px solid #cbd2e3;
                                background: #aeb8d1;
                                color: #445579;
                                font-weight: normal;
                                text-align: left;
                                white-space: nowrap;
                            }
                            .transport-table td {
                                padding: 4px 3px;
                                border-left: 1px solid #d6dbea;
                                border-right: 1px solid #d6dbea;
                                border-bottom: 1px solid #d6dbea;
                                vertical-align: top;
                            }
                            .transport-table .surcharge-row td {
                                background: #dfe3ef;
                                color: #40547c;
                            }
                            .transport-table .summary-row td {
                                border-top: 2px solid #919dbd;
                                background: #f4f5f8;
                                font-size: 11px;
                                font-weight: bold;
                            }
                            .transport-table .summary-row .summary-label {
                                text-align: right;
                                color: #536891;
                                font-size: 13px;
                            }
                            .text-right { text-align: right !important; }
                            .nowrap { white-space: nowrap; }
                            .transport-bottom {
                                margin-top: 26px;
                                page-break-inside: avoid;
                            }
                            .tax-summary {
                                width: 280px;
                                border-collapse: collapse;
                                color: #5a6b91;
                                font-size: 9px;
                            }
                            .tax-summary th,
                            .tax-summary td {
                                padding: 2px 5px;
                                text-align: right;
                            }
                            .invoice-totals {
                                width: 310px;
                                margin-left: auto;
                                border-collapse: collapse;
                                color: #50628b;
                                font-size: 12px;
                            }
                            .invoice-totals td {
                                padding: 3px 5px;
                            }
                            .invoice-totals .amount {
                                text-align: right;
                                color: #39445e;
                                white-space: nowrap;
                            }
                            .invoice-totals .grand-total td {
                                padding-top: 6px;
                                font-size: 14px;
                                font-weight: bold;
                            }
                            .transport-footer {
                                margin-top: 28px;
                                border-top: 1px solid #d9deea;
                                padding-top: 6px;
                                color: #4e5872;
                                font-size: 8.5px;
                                line-height: 1.3;
                            }
                            .transport-footer .page-number {
                                float: right;
                                color: #8eb979;
                            }
                        </style>

                        <table class="transport-header">
                            <tr>
                                <td style="width: 48%;">
                                    <img t-if="company.logo"
                                         t-att-src="image_data_uri(company.logo)"
                                         class="transport-logo"
                                         alt="Company Logo"/>
                                </td>
                                <td style="width: 52%;" class="company-address">
                                    <div><span t-esc="company.street or ''"/></div>
                                    <div t-if="company.street2"><span t-esc="company.street2"/></div>
                                    <div>
                                        <span t-esc="company.city or ''"/>
                                        <t t-if="company.city and company.state_id">, </t>
                                        <span t-esc="company.state_id.name if company.state_id else ''"/>
                                        <t t-if="company.zip">, </t><span t-esc="company.zip or ''"/>
                                    </div>
                                    <div t-if="company.phone"><strong>T:</strong> <span t-esc="company.phone"/></div>
                                    <div t-if="company.email"><strong>E:</strong> <span t-esc="company.email"/></div>
                                    <div class="website" t-if="company.website">
                                        <span t-esc="company.website.replace('http://', '').replace('https://', '')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table class="transport-title-block">
                            <tr>
                                <td style="width: 45%; padding-top: 48px;">
                                    <div class="customer-address">
                                        <div t-if="o.partner_id.name"><strong t-esc="o.partner_id.name"/></div>
                                        <div t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/></div>
                                        <div t-if="o.partner_id.street2"><span t-esc="o.partner_id.street2"/></div>
                                        <div t-if="o.partner_id.city"><span t-esc="o.partner_id.city"/></div>
                                        <div t-if="o.partner_id.state_id"><span t-esc="o.partner_id.state_id.name"/></div>
                                        <div t-if="o.partner_id.zip"><span t-esc="o.partner_id.zip"/></div>
                                    </div>
                                </td>
                                <td style="width: 55%;">
                                    <div class="transport-title">UK Transport - INVOICE</div>
                                    <table class="invoice-meta">
                                        <tr>
                                            <td class="label">Number:</td>
                                            <td class="value"><span t-esc="o.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="label">Tax Point Date:</td>
                                            <td class="value"><span t-field="o.invoice_date"/></td>
                                        </tr>
                                        <tr>
                                            <td class="label">Account Ref:</td>
                                            <td class="value"><span t-esc="o.commercial_partner_id.ref or o.partner_id.ref or ''"/></td>
                                        </tr>
                                        <tr>
                                            <td class="label">Customer Order:</td>
                                            <td class="value"><span t-esc="customer_order or o.ref or o.invoice_origin or ''"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <table class="transport-table">
                            <thead>
                                <tr>
                                    <th style="width: 7%;">Date</th>
                                    <th style="width: 9%;">Client Ref</th>
                                    <th style="width: 9%;">Job No</th>
                                    <th style="width: 10%;">Service</th>
                                    <th style="width: 12%;">Description</th>
                                    <th class="text-right" style="width: 5%;">Weight</th>
                                    <th style="width: 10%;">From</th>
                                    <th style="width: 10%;">To</th>
                                    <th style="width: 12%;">Consignee</th>
                                    <th class="text-right" style="width: 8%;">Value</th>
                                    <th class="text-right" style="width: 8%;">Fuel Chg</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="row">
                                    <tr t-if="row.get('row_type') == 'surcharge'" class="surcharge-row">
                                        <td class="nowrap"><span t-esc="row.get('date').strftime('%d-%b-%y') if row.get('date') else ''"/></td>
                                        <td colspan="8">
                                            <strong>Additional Charges:</strong>
                                            <span t-esc="row.get('service') or ''"/>
                                        </td>
                                        <td class="text-right nowrap">
                                            <span t-out="row.get('value', 0.0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td></td>
                                    </tr>
                                    <tr t-else="">
                                        <td class="nowrap"><span t-esc="row.get('date').strftime('%d-%b-%y') if row.get('date') else ''"/></td>
                                        <td><span t-esc="row.get('client_ref') or ''"/></td>
                                        <td class="nowrap"><span t-esc="row.get('job_no') or ''"/></td>
                                        <td><span t-esc="row.get('service') or ''"/></td>
                                        <td><span t-esc="row.get('description') or ''"/></td>
                                        <td class="text-right nowrap">
                                            <span t-if="row.get('weight')" t-esc="'%g Kg' % row.get('weight')"/>
                                        </td>
                                        <td><span t-esc="row.get('from_postcode') or ''"/></td>
                                        <td><span t-esc="row.get('to_postcode') or ''"/></td>
                                        <td><span t-esc="row.get('consignee') or ''"/></td>
                                        <td class="text-right nowrap">
                                            <span t-out="row.get('value', 0.0)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-right nowrap">
                                            <span t-if="row.get('fuel_charge')" t-out="row.get('fuel_charge')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                                <tr t-if="not rows">
                                    <td colspan="11">No transport legs are linked to the invoiced lines.</td>
                                </tr>
                                <tr class="summary-row" t-if="rows">
                                    <td colspan="5">
                                        <span t-esc="data.get('consignment_count')"/>
                                        <span> Consignment</span><span t-if="data.get('consignment_count') != 1">s</span>
                                    </td>
                                    <td colspan="4" class="summary-label">Summary Total:</td>
                                    <td class="text-right nowrap">
                                        <span t-out="data.get('summary_value')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-right nowrap">
                                        <span t-out="data.get('summary_fuel')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="transport-bottom" t-if="rows">
                            <tr>
                                <td style="width: 55%; padding-top: 20px;">
                                    <table class="tax-summary">
                                        <thead>
                                            <tr><th>Tax Summary</th><th>Goods</th><th>Tax</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><span t-esc="data.get('tax_label') or 'VAT'"/></td>
                                                <td><span t-out="data.get('untaxed')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                                <td><span t-out="data.get('tax')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                                <td style="width: 45%;">
                                    <table class="invoice-totals">
                                        <tr>
                                            <td>Net Amount</td>
                                            <td class="amount"><span t-out="data.get('untaxed')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr>
                                            <td>VAT<t t-if="data.get('tax_label')"> @ <span t-esc="data.get('tax_label')"/></t></td>
                                            <td class="amount"><span t-out="data.get('tax')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                        <tr class="grand-total">
                                            <td>Total</td>
                                            <td class="amount"><span t-out="data.get('total')" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <div class="transport-footer">
                            <div>
                                <strong t-esc="company.name"/>
                                <t t-if="company.company_registry"> | Company Reg no: <span t-esc="company.company_registry"/></t>
                                <t t-if="company.vat"> | VAT: <span t-esc="company.vat"/></t>
                            </div>
                            <div t-if="company.partner_id.bank_ids">
                                <strong>Payment details:</strong>
                                <span t-esc="company.partner_id.bank_ids[0].bank_id.name or ''"/>
                                <t t-if="company.partner_id.bank_ids[0].acc_number"> | Account no: <span t-esc="company.partner_id.bank_ids[0].acc_number"/></t>
                            </div>
                            <div t-if="o.invoice_payment_term_id">
                                <strong>Payment Terms:</strong> <span t-esc="o.invoice_payment_term_id.name"/>
                            </div>
                            <div t-if="company.report_footer" t-out="company.report_footer"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
